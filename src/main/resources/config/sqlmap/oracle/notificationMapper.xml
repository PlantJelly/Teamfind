<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="notification.dao.NotificationDAO">

    <resultMap id="notificationResultMap" type="notificationVO">
        <result property="no"             column="no"/>
        <result property="receiverNo"     column="receiver_no"/>
        <result property="message"        column="message"/>
        <result property="isRead"         column="is_read"/>
        <result property="regDate"        column="reg_date"/>
        <result property="relatedBoardNo" column="related_board_no"/>
        <result property="relatedTeamNo"  column="related_team_no"/>
    </resultMap>

    <insert id="insertNotification" parameterType="notificationVO">
        INSERT INTO project_notification (no, receiver_no, message, is_read, related_board_no, related_team_no, reg_date)
        VALUES (seq_project_notification_no.nextval, #{receiverNo}, #{message}, 'N', #{relatedBoardNo}, #{relatedTeamNo}, sysdate)
    </insert>

    <select id="selectUnreadList" parameterType="int" resultMap="notificationResultMap">
        SELECT no, receiver_no, message, is_read, related_board_no, related_team_no,
               TO_CHAR(reg_date, 'YYYY-MM-DD HH24:MI') AS reg_date
        FROM project_notification
        WHERE receiver_no = #{memberNo}
        ORDER BY no DESC
    </select>

    <select id="countUnread" parameterType="int" resultType="int">
        SELECT COUNT(*) FROM project_notification
        WHERE receiver_no = #{memberNo}
    </select>

    <delete id="deleteOne" parameterType="int">
        DELETE FROM project_notification WHERE no = #{no}
    </delete>

    <delete id="deleteAllByMemberNo" parameterType="int">
        DELETE FROM project_notification WHERE receiver_no = #{memberNo}
    </delete>

    <delete id="deleteByTeamNo" parameterType="int">
        DELETE FROM project_notification WHERE related_team_no = #{teamNo}
    </delete>

</mapper>
